  "authors": [
    "Ice2974"
  ],
  "contact": {
    "homepage": "https://github.com/Ice2974/Carpet-RuneLegend-Addition",
    "sources": "https://github.com/Ice2974/Carpet-RuneLegend-Addition",
    "issues": "https://github.com/Ice2974/Carpet-RuneLegend-Addition/issues"
  },

  "license": "Apache-2.0",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ice2974.carpetrunelegendaddition.CarpetRuneLegendAdditionMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": ">=26.3",
    "java": ">=25",
    "fabric-api": ">=0.165.2+26.3",
    "carpet": ">=26.3"
